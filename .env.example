# ============================================================
# NEXUS - Environment Configuration Template
# Copy this file to .env and fill in real values for local dev.
# Never commit the real .env file.
# ============================================================

# --- App ---
APP_ENV=development
APP_NAME=nexus
APP_DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Backend server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# --- PostgreSQL ---
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev_password
POSTGRES_DB=nexus
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nexus:nexus_dev_password@postgres:5432/nexus

# Host-side port mapping only (container-to-container traffic always uses 5432).
# Override if 5433 also happens to be taken on your machine.
POSTGRES_HOST_PORT=5433

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Host-side port mapping only (container-to-container traffic always uses 6379).
REDIS_HOST_PORT=6380

# --- Auth (dev-only; never hardcode real secrets) ---
JWT_SECRET_KEY=change_me_in_local_env_only
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- LLM Provider (abstracted; fill in when Phase 5 agents are implemented) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL_NAME=
EMBEDDING_PROVIDER=anthropic
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=nexus-backend

# --- CORS ---
CORS_ALLOW_ORIGINS=http://localhost:5173
